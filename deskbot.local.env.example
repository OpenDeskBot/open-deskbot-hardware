# Copy to deskbot.local.env (gitignored).
# Shared by deskbot-rom and deskbot-camera.
#
#   cp deskbot.local.env.example deskbot.local.env
#   （或首次运行 flash_*.sh 时自动从本文件复制）
#
# DEVICE_ID: leave empty → firmware uses deskbot_<mac> at runtime
# DESKBOT_WS_HOST / DESKBOT_WS_PORT: remote WebSocket server (ROM + camera)
# WIFI_SSID / WIFI_PASSWORD: leave empty → ROM AP Deskbot_Rom, Camera AP Deskbot_Camera
#
# Camera vision (compile-time, both can be 1):
#   CAMERA_UPLOAD_JPEG=1       upload JPEG to /camera — remote face recognition
#   CAMERA_LOCAL_FACE_DETECT=1 local face detection, upload landmarks to /face_pos
#   CAMERA_UPLOAD_FPS=10       JPEG upload FPS (0=unlimited, 1–30)
#   CAMERA_FACE_DETECT_FPS=5   local detect/upload FPS (0=unlimited, 1–30)
#
# Format: KEY=value（等号两侧不要空格；改完后保存再烧录）
# flash_*.sh 只读取 deskbot.local.env，不会修改已有文件

DEVICE_ID=
DESKBOT_WS_HOST=39.107.38.241
DESKBOT_WS_PORT=9000
WIFI_SSID=
WIFI_PASSWORD=
CAMERA_UPLOAD_JPEG=1
CAMERA_LOCAL_FACE_DETECT=1
CAMERA_UPLOAD_FPS=10
CAMERA_FACE_DETECT_FPS=5
